# Copy this file to .secrets.env and replace only the values you need.
# Never commit .secrets.env or paste real credentials into scripts.

# Required for Groq-backed prompt/classifier models such as
# qwen/qwen3-32b and qwen/qwen3.6-27b.
export GROQ_API_KEY="replace-with-your-groq-key"

# Required only when an OpenAI-backed model (gpt-* or o*) is selected.
export OPENAI_API_KEY="replace-with-your-openai-key"

# Optional. Used by Hugging Face tooling when downloading private or gated
# model repositories. The experiment launchers default to HF_HUB_OFFLINE=1,
# so enable network access explicitly for the initial download.
export HF_TOKEN="replace-with-your-hugging-face-token"
